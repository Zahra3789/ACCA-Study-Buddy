; Engine configuration file.
; Samurai Ledger — study for ACCA/FIA exams by battling topic monsters (not affiliated with ACCA).
; Built for Godot 4.x. Open this folder in Godot (it finds project.godot).

config_version=5

[application]

config/name="Samurai Ledger"
config/description="A samurai study game for the ACCA FA exam: battle a monster for each topic. Not affiliated with ACCA."
run/main_scene="res://Boot.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icon.png"
config/version="2.8"
config/quit_on_go_back=false

[audio]

general/text_to_speech=true

[autoload]

Game="*res://scripts/Game.gd"
Content="*res://scripts/Content.gd"
UI="*res://scripts/UI.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[gui]

common/snap_controls_to_pixels=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

environment/defaults/default_clear_color=Color(0.0706, 0.051, 0.0863, 1)

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
