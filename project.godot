; Engine configuration file.
; ACCA Study Buddy — study ACCA/FIA exams by battling topic monsters.
; Built for Godot 4.x. Open this folder in Godot (it finds project.godot).

config_version=5

[application]

config/name="ACCA Study Buddy"
config/description="Study ACCA / FIA exams by battling a monster for each topic."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icon.png"

[audio]

general/text_to_speech=true

[autoload]

Game="*res://scripts/Game.gd"
Content="*res://scripts/Content.gd"
UI="*res://scripts/UI.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation="portrait"

[gui]

common/snap_controls_to_pixels=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
