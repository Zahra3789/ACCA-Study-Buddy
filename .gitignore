# Godot 4
.godot/
.import/

# Android build template (regenerated locally)
/android/

# Build outputs — the APK is published to GitHub Releases, not committed
*.apk
*.apk.idsig
/build/

# HTML preview: data.js is regenerated from scripts/Content.gd by preview/serve.ps1
/preview/data.js

# OS cruft
Thumbs.db
.DS_Store
desktop.ini

# Franuka RPG UI pack - licence allows use in the game but NOT redistributing the raw files,
# so they stay out of this public repo. Copy them into assets/rpg/ locally (see CREDITS.md).
/assets/rpg/
# Zuru's sprites come from the FREE_Samurai pixel pack, whose licence forbids redistributing the art as an
# asset - so they ship inside the game but stay out of this public repo. tools/make_zuru.gd rebuilds them.
/assets/characters/
